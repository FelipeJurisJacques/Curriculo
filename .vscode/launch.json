{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker compose -f ./docker/docker-compose.yaml up"
        },
        {
            "name": "Build",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec curriculum_typescript_container npx tsc"
        },
        {
            "name": "Install",
            "request": "launch",
            "type": "node-terminal",
            "command": "docker exec curriculum_typescript_container npm install"
        },
        {
            "request": "launch",
            "name": "Terminal",
            "type": "node-terminal",
            "command": "docker exec -it curriculum_typescript_container bash"
        },
        {
            "request": "launch",
            "type": "node-terminal",
            "name": "Compile Type Script",
            "command": "docker exec curriculum_typescript_container npm run build"
        }
    ]
}